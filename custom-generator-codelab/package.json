{
  "name": "custom-generator-codelab",
  "version": "1.0.0",
  "description": "A sample app using Blockly",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "git submodule update --init --recursive 2>/dev/null || true",
    "setup": "bash setup.sh --build-from-submodule || node setup.js --build-from-submodule",
    "setup:submodule": "bash setup.sh --build-from-submodule || node setup.js --build-from-submodule",
    "setup:dummy": "bash setup.sh --copy-from-dummy || node setup.js --copy-from-dummy",
    "setup:external": "bash setup.sh --build-from-source || node setup.js --build-from-source",
    "prestart": "test -d public/lib || npm run setup",
    "prebuild": "test -d public/lib || npm run setup",
    "dev": "npm run setup && webpack serve --mode development",
    "start": "webpack serve --open --mode development",
    "build": "webpack --mode production",
    "build:all": "npm run setup && npm run build",
    "deploy": "npm run build:all",
    "deploy:prod": "CORS_PROXY_URL=https://b2j-cors-proxy.YOUR_SUBDOMAIN.workers.dev npm run build:all"
  },
  "keywords": [
    "blockly"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "html-webpack-plugin": "^5.6.6",
    "source-map-loader": "^4.0.1",
    "style-loader": "^3.3.1",
    "webpack": "^5.105.4",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@blockly/continuous-toolbox": "^5.0.10",
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "async_hooks": "^1.0.0",
    "blockly": "^10.3.0",
    "buffer": "^6.0.3",
    "fs": "^0.0.1-security",
    "http": "^0.0.1-security",
    "isomorphic-git": "^1.37.2",
    "jszip": "^3.10.1",
    "path": "^0.12.7",
    "querystring": "^0.2.1",
    "stream": "^0.0.2",
    "url": "^0.11.3",
    "util": "^0.12.5",
    "zlib": "^1.0.5"
  }
}
